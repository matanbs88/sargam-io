# Required when the real external transcription provider is connected.
KLANG_API_KEY=

# Required when persistent song caching and accounts are added.
DATABASE_URL=

# Public deployment URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=https://sargam.io

# Optional browser sample override for the Harmonium guide candidate.
# Default: the tonejs-instruments GitHub Pages sample host.
NEXT_PUBLIC_HARMONIUM_SAMPLE_BASE_URL=
NEXT_PUBLIC_WAITLIST_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Development-only local score-PDF pilot. Never enable these on the public
# Vercel deployment. Audiveris is used locally for evaluation only.
SARGAM_LOCAL_OMR_ENABLED=false
AUDIVERIS_BIN=
