# Copy the selected settings to .env.local. Server-only: never NEXT_PUBLIC_.
# No credentials or external requests in mock mode.
TRANSCRIPTION_PROVIDER=mock

# Live audio-file adapter (requires a Klangio account/key; not live-tested here):
# TRANSCRIPTION_PROVIDER=klangio
# KLANGIO_API_KEY=replace_with_your_key
# Alternatively omit TRANSCRIPTION_PROVIDER; a present key selects Klangio.
# A key does not implement live YouTube acquisition.
